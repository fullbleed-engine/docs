# Preserve the exact upstream font license bytes and their original whitespace.
docs/assets/playground/fonts/*-OFL.txt -text whitespace=-blank-at-eol
examples/aspnet/Assets/fonts/*-OFL.txt -text whitespace=-blank-at-eol
examples/aspnet/*.cs text eol=lf
examples/aspnet/*.csproj text eol=lf
examples/aspnet/*.json text eol=lf
examples/aspnet/*.md text eol=lf
examples/aspnet/LICENSE text eol=lf
examples/aspnet/Assets/*.html text eol=lf
examples/aspnet/Assets/*.css text eol=lf
docs/assets/playground/LICENSES.txt text eol=lf whitespace=-blank-at-eol
docs/assets/pdf-regression/*.json text eol=lf
# Evidence downloads and their manifests are verified by byte hashes.
docs/assets/renderer-comparison/** -text
docs/assets/renderer-comparison/*.svg -whitespace
docs/assets/font-subsets/** -text
# Preserve downloadable Commerce PDF bytes and avoid treating streams as text.
docs/assets/commerce/*.pdf binary
# Preserve the exact downloadable Chinese example and its evidence manifests.
docs/assets/chinese-invoice/** -text
# Markdown source, font licenses, and downloads are checked by byte hashes.
examples/markdown/** -text whitespace=cr-at-eol
examples/markdown/fonts/OFL.txt whitespace=cr-at-eol,-blank-at-eol
docs/assets/markdown-starter/** -text whitespace=cr-at-eol
docs/assets/markdown-starter/*.pdf binary
