{
    "name": "fullbleed/laravel-queue-starter",
    "description": "Queued PDF invoices from trusted Blade templates with Fullbleed",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-mbstring": "*",
        "ext-pdo_sqlite": "*",
        "laravel/framework": "^13.0"
    },
    "autoload": {"psr-4": {"App\\": "app/"}},
    "scripts": {
        "post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"]
    },
    "config": {"sort-packages": true, "optimize-autoloader": true, "platform": {"php": "8.3.0"}},
    "minimum-stability": "stable",
    "prefer-stable": true
}
